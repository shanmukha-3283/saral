{
  "name": "saral-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/explain.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
