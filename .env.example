# Copy to api/.env for local dev. Never commit real values.
AWS_REGION=us-east-1
GEMINI_API_KEY=<google-ai-studio-key>
# Comma-separated list — first healthy model wins on 503/429.
GEMINI_MODEL=gemini-3.7-flash,gemini-3.6-flash,gemini-3.8-flash
RESULTS_TABLE=saral-results
CACHE_TABLE=saral-cache
UPLOADS_BUCKET=saral-uploads-<aws-account-id>
PORT=3001
VITE_API_URL=http://localhost:3001
